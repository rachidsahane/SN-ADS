# apps/api: documentation of the variables read by app/config.py (phases 0 and 1).
# In local compose the values come from the root .env; this file is a per-component reference only.
APP_ENV=local
SERVICE_NAME=api
APP_RELEASE=local
LOG_LEVEL=DEBUG
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
MAX_UPLOAD_BYTES=10485760
# Phase 1: Supabase, as seen by the api (keys are generated by `make env-local`; never commit real values)
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me
# Phase 2: token verification, profile cache, bootstrap_admin (SUPABASE_JWT_SECRET is generated by `make env-local`)
SUPABASE_JWT_SECRET=change-me
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
REDIS_URL=redis://redis:6379/0
WEB_APP_URL=http://localhost:3000
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_FULL_NAME=
