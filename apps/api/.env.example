# apps/api: documentation of the variables read by app/config.py (phase 0 scope).
# In local compose the values come from the root .env; this file is a per-component reference only.
APP_ENV=local
SERVICE_NAME=api
APP_RELEASE=local
LOG_LEVEL=DEBUG
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
MAX_UPLOAD_BYTES=10485760
