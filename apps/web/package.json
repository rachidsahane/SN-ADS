{
  "name": "soronua-predict-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "api-types": "openapi-typescript ${OPENAPI_URL:-http://api:8000/api/openapi.json} -o src/lib/api/types.gen.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=critical"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.47.16",
    "@tanstack/react-query": "5.62.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "next": "15.5.27",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "react-hook-form": "7.54.2",
    "recharts": "2.15.4",
    "tailwind-merge": "2.6.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.20.5",
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.27",
    "jsdom": "25.0.1",
    "msw": "2.7.6",
    "openapi-typescript": "7.4.4",
    "postcss": "8.5.28",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
