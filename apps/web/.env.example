# apps/web: documentation of the variables read by src/lib/env.ts and next.config.ts.
# In local compose the values come from the root .env. Never create apps/web/.env (it is bind-mounted).
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_RELEASE=local
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me
NEXT_PUBLIC_SENTRY_DSN=
API_PROXY_TARGET=http://api:8000
