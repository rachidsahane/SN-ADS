-- Shared pgTAP helpers, included by every test file with:  \ir _helpers.psql
-- File extension is .psql on purpose: pg_prove (--ext .sql) runs every *.sql of this folder as a test, and this is not one.
-- Included right after `begin;`, so everything below (schema, functions, fixtures) is created inside the
-- test's own transaction and disappears with its final `rollback;`. Nothing here is a migration and nothing
-- here is ever applied to staging or production.
--
-- Function bodies reference public.* objects only at run time and take text parameters instead of the
-- application's enum types, so this file loads even before the migrations exist (red phase of TDD).
create schema tests;
grant usage on schema tests to anon, authenticated, service_role;

-- Insert one row in auth.users; the on_auth_user_created trigger (migration 1) must create the profile.
create function tests.insert_auth_user(
  p_id uuid, p_email text, p_user_meta jsonb default '{}'::jsonb, p_app_meta jsonb default '{"provider":"email"}'::jsonb
) returns void language plpgsql as $$
begin
  insert into auth.users (instance_id, id, aud, role, email, raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values ('00000000-0000-0000-0000-000000000000', p_id, 'authenticated', 'authenticated', p_email,
          p_app_meta, p_user_meta, now(), now());
end $$;

-- Create a user and give the profile the wanted role / activity (done as the owner, like an admin tool would).
-- Order matters for fixtures: create an active admin BEFORE deactivating or demoting another one
-- (profiles_guard_last_admin refuses to leave zero active admin).
create function tests.create_user(
  p_id uuid, p_email text, p_full_name text default null, p_role text default 'marketer', p_active boolean default true
) returns void language plpgsql as $$
begin
  perform tests.insert_auth_user(
    p_id, p_email,
    case when p_full_name is null then '{}'::jsonb else jsonb_build_object('full_name', p_full_name) end
  );
  if p_role <> 'marketer' then
    update public.profiles set role = p_role::public.app_role where id = p_id;
  end if;
  if not p_active then
    update public.profiles set is_active = false where id = p_id;
  end if;
end $$;

-- Make the fixtures independent of whatever the local database already contains: deactivate every
-- pre-existing admin (guard trigger switched off for this single statement, inside the test transaction).
create function tests.deactivate_existing_admins() returns void language plpgsql as $$
begin
  alter table public.profiles disable trigger profiles_guard_last_admin;
  update public.profiles set is_active = false where role = 'admin' and is_active;
  alter table public.profiles enable trigger profiles_guard_last_admin;
end $$;

-- Switch the session to a database role with the claims PostgREST would set for a verified token.
-- (auth.uid() reads request.jwt.claim.sub in some images and request.jwt.claims in others: set both.)
create function tests.authenticate_as(p_uid uuid) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claim.sub', p_uid::text, true);
  perform set_config('request.jwt.claim.role', 'authenticated', true);
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_uid, 'role', 'authenticated', 'aud', 'authenticated')::text, true);
  set local role authenticated;
end $$;

create function tests.authenticate_as_anon() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('request.jwt.claim.role', 'anon', true);
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  set local role anon;
end $$;

create function tests.authenticate_as_service_role() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('request.jwt.claim.role', 'service_role', true);
  perform set_config('request.jwt.claims', json_build_object('role', 'service_role')::text, true);
  set local role service_role;
end $$;

-- Back to the owner (postgres, the role that runs migrations) with no claims.
create function tests.reset_role() returns void language plpgsql as $$
begin
  reset role;
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('request.jwt.claim.role', '', true);
  perform set_config('request.jwt.claims', '', true);
end $$;

-- Run one data-modifying statement with the CURRENT role (so RLS and grants apply) and return the number of
-- rows it touched. A statement refused by a privilege check raises (42501); one filtered out by RLS returns 0.
create function tests.exec_count(p_sql text) returns bigint language plpgsql as $$
declare n bigint;
begin
  execute p_sql;
  get diagnostics n = row_count;
  return n;
end $$;
grant execute on all functions in schema tests to anon, authenticated, service_role;
