# Soro Nua Campaign Predictor - Supabase stack, LOCAL values.
# `make env-local` copies this file to deploy/supabase/.env (git-ignored) and `generate_keys.py` replaces every
# `change-me` with a generated secret. Placeholders only: no real secret in this file.
# This file is the interpolation source of deploy/supabase/docker-compose.yml only (docker-compose.yml `include`).

# --- Secrets (generated by generate_keys.py, never edited by hand) ---
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me
PG_META_CRYPTO_KEY=change-me
S3_PROTOCOL_ACCESS_KEY_ID=change-me
S3_PROTOCOL_ACCESS_KEY_SECRET=change-me

# --- Public URLs (if KONG_HTTP_PORT changes, change SUPABASE_PUBLIC_URL and API_EXTERNAL_URL with it) ---
SUPABASE_PUBLIC_URL=http://localhost:54321
API_EXTERNAL_URL=http://localhost:54321
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/auth/confirm

# --- Authentication ---
GOTRUE_JWT_EXP=3600

# --- E-mail templates served by web (phase 2, D-053); the local value is the compose-internal address of web ---
GOTRUE_MAILER_TEMPLATES_INVITE=http://web:3000/auth-templates/invite.html
GOTRUE_MAILER_TEMPLATES_RECOVERY=http://web:3000/auth-templates/recovery.html

# --- E-mail (local: Mailpit, no credentials; UI on http://localhost:54324) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@example.test
SMTP_SENDER_NAME=Soro Nua Campaign Predictor

# --- Storage ---
STORAGE_FILE_SIZE_LIMIT=10485760

# --- Host ports and binding (local defaults; Postgres is never published) ---
KONG_HTTP_PORT=54321
KONG_BIND_ADDRESS=127.0.0.1
STUDIO_HOST_PORT=54323
