# Soro Nua Campaign Predictor - LOCAL environment. `make env-local` copies this file to .env (git-ignored).
# Placeholders only. No real secret in this file.

# --- Docker Compose host ports (change only if the default is already used on your machine) ---
WEB_HOST_PORT=3000
API_HOST_PORT=8000

# --- api / worker (apps/api) ---
APP_ENV=local
APP_RELEASE=local
LOG_LEVEL=DEBUG

# --- web (apps/web) ---
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_RELEASE=local
API_PROXY_TARGET=http://api:8000
