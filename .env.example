# Soro Nua Campaign Predictor - LOCAL environment. `make env-local` copies this file to .env (git-ignored).
# Placeholders only. No real secret in this file.

# --- Docker Compose host ports (change only if the default is already used on your machine) ---
WEB_HOST_PORT=3000
API_HOST_PORT=8000
MAILPIT_HOST_PORT=54324
# The Kong (54321) and Studio (54323) host ports are set in deploy/supabase/.env (KONG_HTTP_PORT, STUDIO_HOST_PORT).

# --- api / worker (apps/api) ---
APP_ENV=local
APP_RELEASE=local
LOG_LEVEL=DEBUG

# --- Supabase, as seen by api (the three values below are replaced by `make env-local`) ---
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me
# Database password, read by the toolbox and pgtap services (copied from deploy/supabase/.env)
POSTGRES_PASSWORD=change-me

# --- web (apps/web) ---
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_RELEASE=local
API_PROXY_TARGET=http://api:8000
NEXT_PUBLIC_SUPABASE_URL=http://supabase-kong:8000
# Server-side base URL of web (middleware, /auth/confirm); the browser always uses its own origin (D-069).
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the public anon key: compose maps it from SUPABASE_ANON_KEY.
# Local only: web proxies /auth/v1/* to this target (on AWS the load balancer routes it).
AUTH_PROXY_TARGET=http://supabase-kong:8000

# --- Phase 2: authentication ---
# Copy of the stack JWT_SECRET, replaced by `make env-local`; read by the api only.
SUPABASE_JWT_SECRET=change-me
# Must equal <SUPABASE_PUBLIC_URL>/auth/v1 of deploy/supabase/.env.
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
REDIS_URL=redis://redis:6379/0
# Must equal SITE_URL of deploy/supabase/.env (no trailing slash).
WEB_APP_URL=http://localhost:3000
# First administrator: used by `make bootstrap-admin` (cli service only).
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_FULL_NAME=

# --- Playwright accounts (local only; created by `make test-users`, passwords generated by `make env-local`) ---
E2E_MAILPIT_URL=http://mailpit:8025
E2E_ADMIN_EMAIL=e2e-admin@example.test
E2E_ADMIN_PASSWORD=change-me
E2E_ADMIN2_EMAIL=e2e-admin2@example.test
E2E_ADMIN2_PASSWORD=change-me
E2E_MARKETER_A_EMAIL=e2e-marketer-a@example.test
E2E_MARKETER_A_PASSWORD=change-me
E2E_MARKETER_B_EMAIL=e2e-marketer-b@example.test
E2E_MARKETER_B_PASSWORD=change-me
E2E_RESET_EMAIL=e2e-reset@example.test
E2E_RESET_PASSWORD=change-me
E2E_INVITEE_EMAIL=e2e-invitee@example.test
